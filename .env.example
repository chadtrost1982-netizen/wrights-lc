# Self-hosted OSRM endpoint (server reads this too; the browser does not call OSRM directly)
VITE_OSRM_BASE_URL=https://router.project-osrm.org
# Preferred server-only name for the same setting:
# OSRM_BASE_URL=https://router.project-osrm.org

# Optional. If set on the server, driving distance uses OpenRouteService instead of OSRM.
# Do not prefix with VITE_. The key must never be in the browser bundle.
# ORS_API_KEY=

# Server-only price lock. Either a Microsoft account on ALLOWED_EMAILS, or this password, can load prices.
# Do not prefix with VITE_.
# APP_ACCESS_PASSWORD=
# ALLOWED_EMAILS=chadtrost@hotmail.com
# AZURE_CLIENT_ID=   (optional if VITE_AZURE_CLIENT_ID is already set)

# Shared invoice/estimate counter file inside OneDrive. Created automatically.
# Default: Desktop/Business/Disposal Solutions/counters.json
# VITE_ONEDRIVE_COUNTERS_PATH=Desktop/Business/Disposal Solutions/counters.json

# OneDrive Graph auto-save (Option 1)
# Required for phone+desktop automated saves
VITE_AZURE_CLIENT_ID=
# OneDrive sign-in uses this tenant. common is the right value for a personal Hotmail account.
# The business mailbox does not use it. That sign-in always uses the personal Microsoft
# endpoint (consumers), so disposalsolutions@outlook.com is found even if this is a work tenant.
VITE_AZURE_TENANT_ID=common
# Local dev:
# VITE_AZURE_REDIRECT_URI=http://localhost:5173
# Production:
# VITE_AZURE_REDIRECT_URI=https://your-app-domain.vercel.app
VITE_AZURE_REDIRECT_URI=http://localhost:5173
VITE_REQUIRE_AUTH=true
# Comma-separated allowlist (lower/upper case accepted).
# This is the OneDrive account. Do not replace it with the sending mailbox.
VITE_ALLOWED_EMAILS=chadtrost@hotmail.com
# Optional. Invoices and estimates are emailed from this mailbox.
# Leave unset to use disposalsolutions@outlook.com. No Azure or Vercel change is required.
# The first Send on each browser asks you to sign in as this mailbox. OneDrive stays on the allowlist account.
# VITE_MAIL_FROM=disposalsolutions@outlook.com
# Folder path inside OneDrive root. Leave blank to use the defaults:
# Desktop/Business/Disposal Solutions/Estimates
# Desktop/Business/Disposal Solutions/Invoices
# If these are set to the old Wrights L.C. folders, new files still go there.
VITE_ONEDRIVE_ESTIMATES_PATH=
VITE_ONEDRIVE_INVOICES_PATH=
# Unused. Older setups pointed this at Business/WRIGHTS LC/Invoices.
# It no longer chooses the save folder. Do not set it on Vercel.
# VITE_ONEDRIVE_TARGET_PATH=
